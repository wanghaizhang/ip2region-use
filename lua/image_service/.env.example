# ============================================================================
# .env.example — copy to .env and fill in real values BEFORE deploying.
# Never commit the real .env to version control.
# ============================================================================

# imgproxy bind address inside the Docker network. OpenResty reaches it by host
# name "imgproxy" (see config.lua imgproxy_host). Keep 8080 unless overridden.
IMGPROXY_BIND=0.0.0.0:8080

# ---- signing secret (REQUIRED in production) -------------------------------
# imgproxy signs processed paths with HMAC-SHA256(secret_key, salt + path).
# Generate a strong random value. Keep it server-side only.
IMGPROXY_SECRET_KEY=change-me-to-a-long-random-secret
IMGPROXY_SECRET_SALT=change-me-to-another-long-random-salt

# ---- source allowlist (optional) ------------------------------------------
# Comma-separated hostnames only imgproxy may fetch from. Empty = no restriction
# beyond SSRF protection.
IMGPROXY_ALLOWED_SOURCES=

# ---- resource limits ------------------------------------------------------
IMGPROXY_MAX_SRC_RESOLUTION=20
IMGPROXY_MAX_SRC_FILE_SIZE=20971520
IMGPROXY_MAX_RESULT_DIMENSION=2560
IMGPROXY_MAX_RESULT_PIXELS=10485760
IMGPROXY_ENABLED_EXTENSIONS=jpeg,png,webp,gif,avif
